{
  "name": "sniff-qa",
  "version": "0.7.0",
  "description": "Autonomous QA scanner: point it at your running app and it walks the real user flows in a headless browser and reports what's actually broken — broken pages/links, console & network errors, empty/placeholder data, broken forms, state-loss, bad loading/error states, responsive and accessibility issues — each with reproduction proof, severity, confidence, and a fix. CLI + MCP server. No API key. Uses Playwright and axe-core.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sniff-qa": "dist/cli/index.js",
    "sniff": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "skills",
    ".claude-plugin",
    "smithery.yaml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "keywords": [
    "testing",
    "qa",
    "qa-automation",
    "playwright",
    "accessibility",
    "accessibility-testing",
    "e2e",
    "e2e-testing",
    "ai",
    "ai-testing",
    "claude",
    "visual-regression",
    "visual-regression-testing",
    "ci",
    "automation",
    "a11y",
    "performance",
    "performance-testing",
    "mcp",
    "lighthouse",
    "axe-core",
    "bug-detection",
    "developer-tools",
    "code-quality",
    "wcag"
  ],
  "author": "Adam Boudjemaa <adam@integralayer.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Aboudjem/sniff#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aboudjem/sniff.git"
  },
  "bugs": {
    "url": "https://github.com/Aboudjem/sniff/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.94.0",
    "@axe-core/playwright": "^4.11.1",
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vue/compiler-sfc": "^3.5.32",
    "chrome-launcher": "^1.2.1",
    "commander": "^14.0.3",
    "cosmiconfig": "^9.0.1",
    "fast-glob": "^3.3.3",
    "lighthouse": "^13.1.0",
    "picocolors": "^1.1.1",
    "pixelmatch": "^7.1.0",
    "playwright": "~1.59.1",
    "pngjs": "^7.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^25.6.0",
    "@types/pngjs": "^6.0.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "basic-ftp": "^6.0.1",
    "ip-address": "^10.2.0",
    "postcss": "^8.5.14"
  }
}

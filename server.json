{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Aboudjem/sniff",
  "title": "sniff",
  "description": "Walks your running web app in a real browser and reports what is broken, with steps to reproduce.",
  "repository": {
    "url": "https://github.com/Aboudjem/sniff",
    "source": "github"
  },
  "version": "0.9.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "sniff-qa",
      "version": "0.9.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "--mcp"
        }
      ]
    }
  ]
}
